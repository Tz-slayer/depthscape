{
    "id": "depthscape",
    "name": "Depthscape",
    "description": "Depth-aware wallpaper occlusion and interactive 3D spatial parallax for Dux Shell.",
    "version": "0.5.1",
    "author": "Tz-slayer",
    "repository": "https://github.com/Tz-slayer/depthscape",
    "type": "daemon",
    "capabilities": [
        "daemon"
    ],
    "icon": "layers",
    "components": {
        "daemon": "./qml/DepthDaemon.qml"
    },
    "settings": "./qml/DepthSettings.qml",
    "startupCheck": "./qml/StartupCheck.qml",
    "requires_dms": ">=2.0.0",
    "dependencies": [
        "curl"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process",
        "network"
    ]
}
