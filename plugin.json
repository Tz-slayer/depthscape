{
    "id": "depthscape",
    "name": "Depthscape",
    "description": "AI depth-aware wallpapers: split a wallpaper into background and subject layers so the subject can occlude Depthscape desktop widgets while application windows remain above the scene",
    "version": "0.2.0",
    "author": "Tz-slayer",
    "repository": "https://github.com/Tz-slayer/depthscape",
    "type": "composite",
    "capabilities": [
        "daemon",
        "desktop-widget",
        "ai"
    ],
    "icon": "layers",
    "components": {
        "daemon": "./qml/DepthDaemon.qml",
        "desktop": "./qml/DepthStatusWidget.qml"
    },
    "settings": "./qml/DepthSettings.qml",
    "startupCheck": "./qml/StartupCheck.qml",
    "requires_dms": ">=1.5.0",
    "dependencies": [
        "curl"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process",
        "network"
    ]
}
